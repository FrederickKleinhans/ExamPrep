    {
      "id": "az204-010",
      "type": "dropdown-select",
      "topicId": "azure-services",
      "difficulty": "medium",
      "points": 1,
      "questionText": "You need to process millions of IoT messages per second. Choose the correct service:",
      "dropdowns": [
        {
          "id": "d1",
          "prompt": "Service",
          "options": [
            "Azure Service Bus",
            "Azure Event Grid",
            "Azure Event Hubs",
            "Azure Queue Storage"
          ],
          "correctAnswer": "Azure Event Hubs"
        }
      ],
      "explanation": {
        "correct": "Event Hubs is built for high-throughput telemetry ingestion.",
        "incorrect": "Service Bus and Queue Storage are for lower throughput; Event Grid is for event routing.",
        "examTip": "Event Hubs uses partitions for scalability.",
        "relatedTopics": [
          "Event Hubs"
        ]
      },
      "metadata": {
        "examObjective": "Connect to Azure services",
