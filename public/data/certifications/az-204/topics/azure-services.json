      "id": "az204-006",
      "type": "drag-drop",
      "topicId": "azure-services",
      "difficulty": "hard",
      "points": 1,
      "questionText": "Match the Azure service to its primary use case:",
      "dragCategories": [
        {
          "id": "cat1",
          "name": "Event-driven serverless compute",
          "acceptsItemIds": [
            "item1"
          ]
        },
        {
          "id": "cat2",
          "name": "Hybrid integration for enterprise workflows",
          "acceptsItemIds": [
            "item2"
          ]
        },
        {
          "id": "cat3",
          "name": "Real-time data ingestion and analytics",
          "acceptsItemIds": [
            "item3"
          ]
        }
      ],
      "dragItems": [
        {
          "id": "item1",
          "text": "Azure Functions"
        },
        {
          "id": "item2",
          "text": "Azure Logic Apps"
        },
        {
          "id": "item3",
          "text": "Azure Event Hubs"
        }
      ],
      "explanation": {
        "correct": "Azure Functions is event-driven; Logic Apps is for workflow integration; Event Hubs for telemetry ingestion.",
        "incorrect": "Mixing them up misses their distinct purposes.",
        "examTip": "Remember Functions are code-first, Logic Apps are designer-first.",
