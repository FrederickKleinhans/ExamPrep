        },
        {
          "id": "B",
          "text": "Azure Service Bus",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Azure Event Grid",
          "isCorrect": true
        },
        {
          "id": "D",
          "text": "Azure Notification Hubs",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Event Grid is ideal for event-driven reactive processing with many subscribers.",
        "incorrect": "Event Hubs is for streaming; Service Bus is for messaging; Notification Hubs for push notifications.",
        "examTip": "Use Event Grid for event-driven architectures.",
        "relatedTopics": [
          "Event Grid"
