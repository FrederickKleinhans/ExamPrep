    {
      "id": "az204-015",
      "type": "yes-no-statements",
      "topicId": "azure-services",
      "difficulty": "medium",
      "points": 1,
      "questionText": "You are using Azure Service Bus topics with subscriptions. Evaluate these statements:",
      "statements": [
        {
          "id": "s1",
          "text": "Each subscription receives a copy of the message.",
          "isCorrectYes": true
        },
        {
          "id": "s2",
          "text": "You can apply filters to subscriptions.",
          "isCorrectYes": true
        },
        {
          "id": "s3",
          "text": "Messages are removed from the topic when one subscription reads them.",
          "isCorrectYes": false
        }
      ],
      "explanation": {
        "correct": "Topics broadcast messages to all subscriptions and filters can be applied.",
        "incorrect": "Messages remain until all subscriptions have read them (unless auto-delete).",
        "examTip": "Topics are for publish/subscribe patterns with multiple consumers.",
        "relatedTopics": [
          "Service Bus topics"
        ]
      },
      "metadata": {
        "examObjective": "Connect to Azure services",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
