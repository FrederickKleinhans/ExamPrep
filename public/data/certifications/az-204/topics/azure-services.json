    {
      "id": "az204-023",
      "type": "ordering",
      "topicId": "azure-services",
      "difficulty": "medium",
      "points": 1,
      "questionText": "Order the steps for creating a new API Management instance and applying a policy:",
      "orderItems": [
        {
          "id": "o1",
          "text": "Create API Management service",
          "correctPosition": 1
        },
        {
          "id": "o2",
          "text": "Add an API",
          "correctPosition": 2
        },
        {
          "id": "o3",
          "text": "Create a policy (e.g., rate limiting)",
          "correctPosition": 3
        },
        {
          "id": "o4",
          "text": "Publish the API product",
          "correctPosition": 4
        }
      ],
      "explanation": {
        "correct": "Service, then API, then policy, then product publish.",
