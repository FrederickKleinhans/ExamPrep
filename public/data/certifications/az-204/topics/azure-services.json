    {
      "id": "az204-019",
      "type": "single-choice",
      "topicId": "azure-services",
      "difficulty": "medium",
      "points": 1,
      "scenarioText": "You are building an e-commerce system that sends order confirmation emails and updates inventory. You want to decouple email and inventory processing.",
      "questionText": "Which Azure service should you use to publish order events?",
      "options": [
        {
          "id": "A",
          "text": "Azure Event Hubs",
