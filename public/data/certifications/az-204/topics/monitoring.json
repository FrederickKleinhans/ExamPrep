      "id": "az204-005",
      "type": "ordering",
      "topicId": "monitoring",
      "difficulty": "medium",
      "points": 1,
      "questionText": "Order the steps for setting up Availability Tests in Application Insights:",
      "orderItems": [
        {
          "id": "o1",
          "text": "Create an Application Insights resource",
          "correctPosition": 1
        },
        {
          "id": "o2",
          "text": "Navigate to the Availability pane",
          "correctPosition": 2
        },
        {
          "id": "o3",
          "text": "Add a new URL ping test",
          "correctPosition": 3
        },
        {
          "id": "o4",
          "text": "Configure alert rules",
          "correctPosition": 4
        }
      ],
      "explanation": {
        "correct": "First create the resource, then add the test, configure alerts.",
        "incorrect": "Must create resource before tests.",
        "examTip": "Availability tests help monitor endpoint responsiveness.",
        "relatedTopics": [
          "Application Insights"
        ]
      },
      "metadata": {
        "examObjective": "Monitor Azure solutions",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
    {
      "id": "az204-014",
      "type": "multiple-choice",
      "topicId": "monitoring",
      "difficulty": "medium",
      "points": 1,
      "questionText": "Which Application Insights features can help diagnose performance issues in a web app? (Choose three.)",
      "options": [
        {
          "id": "A",
          "text": "Live Metrics",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Availability tests",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Profiler",
          "isCorrect": true
        },
        {
          "id": "D",
          "text": "Snapshot Debugger",
          "isCorrect": true
        },
        {
          "id": "E",
          "text": "Smart Detection",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Live Metrics, Profiler, and Snapshot Debugger help with real-time and detailed performance analysis.",
        "incorrect": "Availability tests check uptime; Smart Detection alerts anomalies.",
        "examTip": "Use Profiler for CPU and Snapshot for exceptions.",
        "relatedTopics": [
          "Application Insights performance tools"
        ]
      },
      "metadata": {
        "examObjective": "Monitor Azure solutions",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
