    {
      "id": "az204-022",
      "type": "dropdown-select",
      "topicId": "monitoring",
      "difficulty": "easy",
      "points": 1,
      "questionText": "You need to query application logs that are stored in Azure Log Analytics. Which language should you use?",
      "dropdowns": [
        {
          "id": "d1",
          "prompt": "Query language",
          "options": [
            "SQL",
            "KQL",
            "SPARQL",
            "XPath"
          ],
          "correctAnswer": "KQL"
        }
      ],
      "explanation": {
        "correct": "KQL is the standard language for Azure Log Analytics.",
        "incorrect": "SQL works in Azure SQL, not Log Analytics; SPARQL and XPath are for other uses.",
        "examTip": "Use KQL for powerful diagnostics queries.",
        "relatedTopics": [
          "Azure Monitor log queries"
        ]
      },
      "metadata": {
        "examObjective": "Monitor Azure solutions",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
