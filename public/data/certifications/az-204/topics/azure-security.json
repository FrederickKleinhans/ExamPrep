    {
      "id": "az204-004",
      "type": "dropdown-select",
      "topicId": "azure-security",
      "difficulty": "medium",
      "points": 1,
      "questionText": "Select the correct option to complete the sentence: To authenticate a web app to Azure Key Vault without storing credentials in code, you should use a __________.",
      "dropdowns": [
        {
          "id": "d1",
          "prompt": "Authentication method",
          "options": [
            "client secret",
            "connection string",
            "managed identity",
            "certificate thumbprint"
          ],
          "correctAnswer": "managed identity"
        }
      ],
      "explanation": {
        "correct": "Managed identity provides an automatically managed identity for the app to access Key Vault.",
        "incorrect": "Client secrets, certificates, or connection strings require manual management.",
        "examTip": "Use managed identities to avoid hardcoding credentials.",
        "relatedTopics": [
          "Managed identities"
        ]
      },
      "metadata": {
        "examObjective": "Implement Azure security",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
    {
      "id": "az204-009",
      "type": "yes-no-statements",
      "topicId": "azure-security",
      "difficulty": "medium",
      "points": 1,
      "questionText": "You are using Azure Key Vault for certificate management. Evaluate these statements:",
      "statements": [
        {
          "id": "s1",
          "text": "Access policies can be used to grant permission to a specific user.",
          "isCorrectYes": true
        },
        {
          "id": "s2",
          "text": "RBAC roles are the only authorization model supported.",
          "isCorrectYes": false
        },
        {
          "id": "s3",
          "text": "Key Vault can auto-renew certificates.",
          "isCorrectYes": true
        }
      ],
      "explanation": {
        "correct": "Key Vault supports both access policies and RBAC, and can auto-renew.",
        "incorrect": "RBAC is not the only model; access policies are also available.",
        "examTip": "Use RBAC for broader management, access policies for granular permissions.",
        "relatedTopics": [
          "Key Vault access models"
        ]
      },
      "metadata": {
        "examObjective": "Implement Azure security",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
