    {
      "id": "az204-013",
      "type": "single-choice",
      "topicId": "azure-security",
      "difficulty": "easy",
      "points": 1,
      "questionText": "Which authentication flow is recommended for a native mobile application calling Azure AD-protected APIs?",
      "options": [
        {
          "id": "A",
          "text": "Authorization code grant with PKCE",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Client credentials grant",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Resource owner password credentials",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "Device code flow",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "PKCE is secure for mobile apps because it mitigates code interception.",
        "incorrect": "Client credentials are for daemons; password flow is deprecated; device flow is for headless devices.",
        "examTip": "Always use PKCE for native apps.",
        "relatedTopics": [
          "MSAL authentication flows"
        ]
      },
      "metadata": {
        "examObjective": "Implement Azure security",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
