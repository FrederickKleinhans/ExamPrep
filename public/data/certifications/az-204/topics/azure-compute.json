      "id": "az204-001",
      "type": "single-choice",
      "topicId": "azure-compute",
      "difficulty": "easy",
      "points": 1,
      "questionText": "You deploy a web app to Azure App Service using the Free tier. Which action requires scaling up to a higher tier?",
      "options": [
        {
          "id": "A",
          "text": "Add a custom domain",
          "isCorrect": false
        },
        {
          "id": "B",
          "text": "Enable diagnostic logs",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Configure daily backups",
          "isCorrect": true
        },
        {
          "id": "D",
          "text": "Set application settings",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Daily backups are supported only in Basic tier and higher.",
        "incorrect": "Custom domains, diagnostic logs, and application settings are available in Free tier.",
        "examTip": "Remember backup and custom domain SSL are not available in Free/Shared tiers.",
        "relatedTopics": [
          "App Service scaling"
        ]
      },
      "metadata": {
        "examObjective": "Configure App Service plans",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
    {
      "id": "az204-002",
      "type": "multiple-choice",
      "topicId": "azure-compute",
      "difficulty": "medium",
      "points": 1,
      "questionText": "You are designing an Azure Function app that processes orders from a queue. Which triggers can you use? (Choose two.)",
      "options": [
        {
          "id": "A",
          "text": "Service Bus Queue trigger",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Blob Storage trigger",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Event Grid trigger",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "Azure Queue Storage trigger",
          "isCorrect": true
        },
        {
          "id": "E",
          "text": "HTTP trigger",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Service Bus Queue and Azure Queue Storage triggers are queue-based.",
        "incorrect": "Blob Storage and Event Grid are not queue triggers; HTTP is for web requests.",
