    {
      "id": "az204-007",
      "type": "single-choice",
      "topicId": "azure-compute",
      "difficulty": "medium",
      "points": 1,
      "scenarioText": "You are developing a web application that must support staging and production environments. You need to minimize downtime during deployments.",
      "questionText": "Which App Service feature should you use to swap environments with zero downtime?",
      "options": [
        {
          "id": "A",
          "text": "Deployment slots",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Auto-scaling",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Backup",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "Custom domains",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Deployment slots allow swapping staging and production without downtime.",
        "incorrect": "Auto-scaling handles load, backup is for recovery, custom domains are for branding.",
        "examTip": "Use deployment slots for safe staging and rollback.",
        "relatedTopics": [
          "App Service deployment slots"
        ]
      },
      "metadata": {
        "examObjective": "Develop Azure Compute Solutions",
