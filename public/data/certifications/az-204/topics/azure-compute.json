      "id": "az204-020",
      "type": "multiple-choice",
      "topicId": "azure-compute",
      "difficulty": "hard",
      "points": 1,
      "questionText": "You are designing a durable function that orchestrates multiple activities. Which statements about durable functions are true? (Choose two.)",
      "options": [
        {
          "id": "A",
          "text": "Orchestrator functions must be deterministic.",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Activity functions can call orchestrator functions.",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "The function can be stopped and resumed.",
          "isCorrect": true
        },
        {
          "id": "D",
          "text": "Durable Functions only run in Consumption plan.",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Orchestrators are deterministic; they can be stopped/resumed via replay.",
        "incorrect": "Activity functions cannot call orchestrators; they can run in any plan.",
        "examTip": "Avoid I/O inside orchestrators Ã¢â‚¬â€ use activity functions.",
        "relatedTopics": [
