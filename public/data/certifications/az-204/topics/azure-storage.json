      "id": "az204-003",
      "type": "yes-no-statements",
      "topicId": "azure-storage",
      "difficulty": "easy",
      "points": 1,
      "questionText": "You create an Azure Blob Storage container with private access. Evaluate the following statements:",
      "statements": [
        {
          "id": "s1",
          "text": "You can generate a shared access signature (SAS) to allow temporary read access.",
          "isCorrectYes": true
        },
        {
          "id": "s2",
          "text": "The storage account key is the only way to access the container.",
          "isCorrectYes": false
        },
        {
          "id": "s3",
          "text": "You can assign RBAC roles to control access.",
          "isCorrectYes": true
        }
      ],
      "explanation": {
        "correct": "SAS and RBAC provide secure access without sharing account keys.",
        "incorrect": "Storage account keys are not the only method; SAS and RBAC also work.",
        "examTip": "Prefer managed identities and RBAC over access keys.",
        "relatedTopics": [
          "Azure Storage security"
        ]
      },
      "metadata": {
        "examObjective": "Develop Azure Storage solutions",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
    {
      "id": "az204-008",
      "type": "multiple-choice",
      "topicId": "azure-storage",
      "difficulty": "hard",
      "points": 1,
      "scenarioText": "Your application uploads large video files to Azure Blob Storage. Users can request downloads with a time-limited link.",
      "questionText": "Which two approaches can generate a time-limited download URL? (Choose two.)",
      "options": [
        {
          "id": "A",
          "text": "Create a shared access signature (SAS) with an expiry time",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Set the blob's metadata property to expire",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "Use a stored access policy with an expiry",
          "isCorrect": true
        },
        {
          "id": "D",
          "text": "Generate a new storage account key",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "SAS and stored access policies both allow expiring access.",
        "incorrect": "Metadata does not enforce access expiry; rotating keys is not time-limited.",
        "examTip": "Stored access policies give you more control and can be revoked.",
        "relatedTopics": [
          "Blob Storage SAS"
        ]
      },
      "metadata": {
        "examObjective": "Develop Azure Storage solutions",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
