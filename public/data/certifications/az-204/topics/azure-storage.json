      "type": "dropdown-select",
      "topicId": "azure-storage",
      "difficulty": "hard",
      "points": 1,
      "questionText": "In Cosmos DB, to guarantee that reads return the latest write across all regions, you should set consistency level to _____.",
      "dropdowns": [
        {
          "id": "d1",
          "prompt": "Consistency level",
