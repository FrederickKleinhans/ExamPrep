    {
      "id": "az204-021",
      "type": "yes-no-statements",
      "topicId": "azure-storage",
      "difficulty": "medium",
      "points": 1,
      "questionText": "You are using Azure Cosmos DB with multiple consistency levels. Evaluate these statements:",
      "statements": [
        {
          "id": "s1",
          "text": "Strong consistency guarantees immediate read-after-write.",
          "isCorrectYes": true
        },
        {
          "id": "s2",
          "text": "Session consistency is the default level.",
          "isCorrectYes": true
        },
        {
          "id": "s3",
          "text": "Eventual consistency ensures no data loss.",
          "isCorrectYes": false
        }
      ],
      "explanation": {
        "correct": "Strong guarantees global order; session is default; eventual does not guarantee durability.",
        "incorrect": "Eventual does not ensure no data loss.",
        "examTip": "Choose consistency based on your application's needs.",
        "relatedTopics": [
          "Cosmos DB consistency"
        ]
      },
      "metadata": {
        "examObjective": "Develop Azure Storage solutions",
        "references": [
          "https://learn.microsoft.com/en-us/certifications/exams/az-204"
        ],
