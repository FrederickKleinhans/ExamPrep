      "exam": "core1",
      "type": "yes-no-statements",
      "topicId": "networking",
      "difficulty": "easy",
      "points": 1,
      "questionText": "Evaluate each statement about IP addressing.",
      "statements": [
        {
          "id": "s1",
          "text": "IPv4 uses 32-bit addresses.",
          "isCorrectYes": true
        },
        {
          "id": "s2",
          "text": "IPv6 uses 64-bit addresses.",
          "isCorrectYes": false
        },
        {
          "id": "s3",
          "text": "APIPA addresses are in the 169.254.0.0/16 range.",
          "isCorrectYes": true
        },
        {
          "id": "s4",
          "text": "DHCP is used for dynamic IP assignment.",
          "isCorrectYes": true
        }
      ],
      "explanation": {
        "correct": "IPv4 is 32-bit; IPv6 is 128-bit; APIPA is 169.254.x.x; DHCP assigns IPs dynamically.",
        "incorrect": "IPv6 is 128-bit, not 64-bit.",
        "examTip": "Know the difference between IPv4 and IPv6 address lengths.",
        "relatedTopics": [
          "IPv4 vs IPv6",
          "APIPA",
          "DHCP"
        ]
      },
      "metadata": {
