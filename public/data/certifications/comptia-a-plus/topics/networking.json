      "id": "aplus-002",
      "exam": "core1",
      "type": "single-choice",
      "topicId": "networking",
      "difficulty": "easy",
      "points": 1,
      "questionText": "Which TCP port is used for HTTPS?",
      "options": [
        {
          "id": "A",
          "text": "80",
          "isCorrect": false
        },
        {
          "id": "B",
          "text": "443",
          "isCorrect": true
        },
        {
          "id": "C",
          "text": "25",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "53",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "HTTPS uses port 443 by default.",
        "incorrect": "Port 80 is HTTP, 25 is SMTP, 53 is DNS.",
        "examTip": "Memorize common port numbers: HTTP=80, HTTPS=443, SSH=22.",
        "relatedTopics": [
          "TCP/IP ports",
          "web protocols"
        ]
      },
      "metadata": {
        "examObjective": "2.1: Compare and contrast common networking protocols and ports",
        "references": [
          "https://www.comptia.org/certifications/a"
