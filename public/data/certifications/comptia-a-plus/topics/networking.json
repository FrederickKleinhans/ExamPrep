          "text": "802.11ac",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "802.11n",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "802.11a",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "802.11b",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "802.11ac (Wi-Fi 5) operates at 5 GHz and is faster than 802.11n.",
        "incorrect": "802.11n supports both 2.4 and 5 GHz but is slower.",
        "examTip": "802.11ac is the predecessor to Wi-Fi 6 (802.11ax).",
        "relatedTopics": [
          "Wireless standards",
          "Wi-Fi frequencies"
        ]
      },
