            "ping",
            "tracert",
            "netstat",
            "nslookup"
          ],
          "correctAnswer": "ping"
        },
        {
          "id": "d2",
          "prompt": "Displays active connections and ports",
          "options": [
            "ping",
            "tracert",
            "netstat",
            "nslookup"
          ],
          "correctAnswer": "netstat"
        },
        {
          "id": "d3",
          "prompt": "Queries DNS for domain name resolution",
          "options": [
            "ping",
            "tracert",
            "netstat",
            "nslookup"
          ],
          "correctAnswer": "nslookup"
        }
      ],
      "explanation": {
        "correct": "ping = connectivity; netstat = connections; nslookup = DNS.",
        "incorrect": "Other tools have different purposes.",
