      "id": "aplus-001",
      "exam": "core1",
      "type": "single-choice",
      "topicId": "hardware",
      "difficulty": "easy",
      "points": 1,
      "questionText": "Which of the following RAM types is commonly used in laptops?",
      "options": [
        {
          "id": "A",
          "text": "SO-DIMM DDR4",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "DIMM DDR4",
          "isCorrect": false
        },
        {
          "id": "C",
          "text": "RIMM DDR3",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "SIMM DDR2",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "SO-DIMM (Small Outline DIMM) is the smaller form factor used in laptops.",
        "incorrect": "DIMM is used in desktops; RIMM and SIMM are obsolete.",
        "examTip": "Remember that laptops use SO-DIMM; desktops use DIMM.",
        "relatedTopics": [
          "RAM types",
          "form factors"
        ]
      },
      "metadata": {
        "examObjective": "1.1: Compare and contrast RAM types and features",
        "references": [
          "https://www.comptia.org/certifications/a"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
    {
      "id": "aplus-004",
      "exam": "core1",
      "type": "multiple-choice",
      "topicId": "hardware",
      "difficulty": "medium",
      "points": 1,
      "scenarioText": "A user reports that their computer won't boot and makes beeping sounds. You suspect a hardware issue.",
      "questionText": "Which of the following could cause this issue? (Choose two.)",
      "options": [
        {
          "id": "A",
          "text": "Loose RAM module",
          "isCorrect": true
        },
        {
          "id": "B",
          "text": "Faulty power supply",
          "isCorrect": true
        },
        {
          "id": "C",
          "text": "Corrupted operating system",
          "isCorrect": false
        },
        {
          "id": "D",
          "text": "Outdated BIOS",
          "isCorrect": false
        }
      ],
      "explanation": {
        "correct": "Loose RAM and faulty PSU are common hardware causes of beep codes.",
        "incorrect": "Corrupted OS and outdated BIOS are less likely to cause beep codes.",
        "examTip": "Beep codes often indicate hardware problems like RAM or video.",
        "relatedTopics": [
          "POST beep codes",
          "hardware troubleshooting"
        ]
      },
      "metadata": {
        "examObjective": "5.2: Given a scenario, troubleshoot hardware and network issues",
        "references": [
          "https://www.comptia.org/certifications/a"
        ],
        "lastUpdated": "2024-01-15",
        "reviewStatus": "draft"
      }
    },
    {
      "id": "aplus-006",
      "exam": "core1",
      "type": "dropdown-select",
      "topicId": "hardware",
      "difficulty": "medium",
      "points": 1,
      "questionText": "Select the correct RAID level for each description.",
      "dropdowns": [
        {
          "id": "d1",
          "prompt": "Striping with no redundancy",
          "options": [
            "RAID 0",
            "RAID 1",
            "RAID 5",
            "RAID 10"
          ],
          "correctAnswer": "RAID 0"
        },
        {
          "id": "d2",
          "prompt": "Mirroring",
          "options": [
            "RAID 0",
            "RAID 1",
            "RAID 5",
            "RAID 10"
          ],
          "correctAnswer": "RAID 1"
        },
        {
          "id": "d3",
          "prompt": "Striping with parity",
          "options": [
            "RAID 0",
            "RAID 1",
            "RAID 5",
            "RAID 10"
          ],
          "correctAnswer": "RAID 5"
        }
      ],
      "explanation": {
        "correct": "RAID 0 = striping, RAID 1 = mirroring, RAID 5 = striping with parity.",
        "incorrect": "Other options don't match these definitions.",
        "examTip": "RAID 5 requires at least 3 drives; RAID 10 is mirrored striped sets.",
        "relatedTopics": [
          "RAID levels",
          "storage redundancy"
        ]
      },
      "metadata": {
        "examObjective": "1.3: Compare and contrast storage devices and RAID levels",
        "references": [
          "https://www.comptia.org/certifications/a"
        ],
        "lastUpdated": "2024-01-15",
