      "topicId": "hardware",
      "difficulty": "medium",
      "points": 1,
      "questionText": "Arrange the steps to install a new M.2 NVMe SSD in a desktop PC.",
      "orderItems": [
        {
          "id": "o1",
          "text": "Power off the PC and unplug it",
          "correctPosition": 1
        },
        {
          "id": "o2",
          "text": "Open the case and locate the M.2 slot",
          "correctPosition": 2
        },
        {
          "id": "o3",
          "text": "Insert the M.2 drive at an angle and secure with screw",
          "correctPosition": 3
        },
        {
          "id": "o4",
          "text": "Close the case and power on",
          "correctPosition": 4
        }
      ],
      "explanation": {
        "correct": "1: Power off, 2: Open case, 3: Install drive, 4: Close and power on.",
        "incorrect": "Ordering errors could damage components.",
        "examTip": "Always ground yourself before handling internal components.",
        "relatedTopics": [
          "M.2 installation",
          "storage installation"
        ]
      },
