      "points": 1,
      "questionText": "Determine if each statement about mobile device connectors is true or false.",
      "statements": [
        {
          "id": "s1",
          "text": "USB-C supports video output.",
          "isCorrectYes": true
        },
        {
          "id": "s2",
          "text": "Lightning is an open standard.",
          "isCorrectYes": false
        },
        {
          "id": "s3",
          "text": "micro-USB supports USB OTG.",
          "isCorrectYes": true
        },
        {
          "id": "s4",
          "text": "Thunderbolt 3 uses USB-C connector.",
          "isCorrectYes": true
        }
      ],
      "explanation": {
        "correct": "USB-C supports video; Lightning is proprietary; micro-USB supports OTG; Thunderbolt 3 uses USB-C.",
        "incorrect": "Lightning is Apple proprietary.",
        "examTip": "USB-C is becoming the universal connector.",
        "relatedTopics": [
          "Mobile device connectors",
          "USB standards"
        ]
      },
