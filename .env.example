# CertArc — Environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and should never be committed.

# Supabase project URL (found in Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (found in Supabase Dashboard → Settings → API)
# This key is safe to expose in the browser — it's restricted by Row Level Security.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Without these variables the app runs in guest-only mode (localStorage only).
# Auth and cross-device sync will be unavailable but everything else works.
